# CieloBot rootfs
#
# 目标：一个能跑 QQ(NapCat) 的最小 Debian 环境。
# 由 build-rootfs.sh 用 buildx --platform linux/arm64 构建。

FROM --platform=linux/arm64 debian:bookworm-slim

ENV DEBIAN_FRONTEND=noninteractive
ENV LANG=C.UTF-8

# QQ 在无头环境需要的库：gtk3 / nss / xss / atspi / gbm / gtk2 兼容
RUN apt-get update && apt-get install -y --no-install-recommends \
      ca-certificates curl unzip jq procps gosu \
      xvfb dbus-x11 \
      libgtk-3-0 libgtk2.0-0 libnotify4 libnss3 libxss1 libxtst6 \
      libatspi2.0-0 libsecret-1-0 libgbm1 libasound2 \
      libxcb1 libxkbcommon0 libpango-1.0-0 libcairo2 \
      fonts-noto-cjk \
    && rm -rf /var/lib/apt/lists/*

# QQ（deb 会装到 /opt/QQ）
COPY QQ.deb /tmp/QQ.deb
RUN apt-get install -y /tmp/QQ.deb && rm -f /tmp/QQ.deb

# NapCat（放进 /app/napcat）
COPY NapCat.Shell.zip /app/NapCat.Shell.zip
RUN cd /app \
    && unzip -q NapCat.Shell.zip -d NapCat.Shell \
    && mkdir -p napcat/config \
    && cp -rf NapCat.Shell/* napcat/ \
    && rm -rf NapCat.Shell NapCat.Shell.zip

COPY entrypoint.sh /app/entrypoint.sh
RUN chmod +x /app/entrypoint.sh

# napcat 用户：QQ 拒绝以 root 跑（Chromium 沙箱）
RUN useradd -m -s /bin/bash napcat || true \
    && chown -R napcat:napcat /app

WORKDIR /app

ENTRYPOINT ["/bin/bash", "/app/entrypoint.sh"]
