<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/yn_bg_hover"/>
            <stroke android:width="1dp" android:color="@color/yn_border_strong"/>
        </shape>
    </item>
    <item>
        <layer-list>
            <item android:left="4dp" android:top="4dp">
                <shape android:shape="rectangle">
                    <solid android:color="@color/yn_shadow_soft"/>
                </shape>
            </item>
            <item android:right="4dp" android:bottom="4dp">
                <shape android:shape="rectangle">
                    <solid android:color="@color/yn_bg_elevated"/>
                    <stroke android:width="1dp" android:color="@color/yn_border"/>
                </shape>
            </item>
        </layer-list>
    </item>
</selector>
