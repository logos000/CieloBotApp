<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <layer-list>
            <item android:left="0dp" android:top="0dp" android:right="5dp" android:bottom="5dp">
                <shape android:shape="rectangle">
                    <solid android:color="@color/yn_accent_hover"/>
                </shape>
            </item>
        </layer-list>
    </item>
    <item>
        <layer-list>
            <!-- 阴影层：向右下偏移 -->
            <item android:left="5dp" android:top="5dp">
                <shape android:shape="rectangle">
                    <solid android:color="@color/yn_shadow"/>
                </shape>
            </item>
            <!-- 面层 -->
            <item android:right="5dp" android:bottom="5dp">
                <shape android:shape="rectangle">
                    <solid android:color="@color/yn_accent"/>
                </shape>
            </item>
        </layer-list>
    </item>
</selector>
