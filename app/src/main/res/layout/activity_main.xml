<?xml version="1.0" encoding="utf-8"?>
<!--
  Fixed-height gate terminal: no page scroll.
  Header strip / compact readout / action row / live terminal tail.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/yn_bg_base">

    <!-- ── top strip ─────────────────────────────── -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="34dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="18dp"
        android:paddingEnd="18dp">

        <View
            android:layout_width="12dp"
            android:layout_height="12dp"
            android:background="@drawable/yn_mark"/>

        <TextView
            style="@style/YnMeta"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="7dp"
            android:text="CIELO / BOT NODE"/>

        <TextView
            android:id="@+id/clock"
            style="@style/YnMeta"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:textColor="@color/yn_ink_muted"
            android:text="--:--:--"/>

        <TextView
            style="@style/YnMeta"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="MOB-01"/>
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/yn_border"/>

    <!-- ── compact masthead: one line ────────────── -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="bottom"
        android:paddingStart="18dp"
        android:paddingEnd="18dp"
        android:paddingTop="10dp">

        <TextView
            style="@style/YnTitle"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:textSize="26sp"
            android:letterSpacing="0.03"
            android:text="CIELO BOT"/>

        <TextView
            style="@style/YnMeta"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="5dp"
            android:textColor="@color/yn_accent_ink"
            android:text="TERMINAL / 0.2"/>
    </LinearLayout>

    <!-- ── readout rows ──────────────────────────── -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="18dp"
        android:paddingEnd="18dp"
        android:paddingTop="8dp">

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/yn_border_subtle"/>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingTop="6dp"
            android:paddingBottom="6dp">

            <TextView style="@style/YnValue" android:layout_width="52dp"
                android:layout_height="wrap_content" android:textSize="10sp"
                android:textColor="@color/yn_ink_muted" android:text="SYS/00"/>

            <TextView style="@style/YnValue" android:layout_width="0dp"
                android:layout_weight="1" android:layout_height="wrap_content"
                android:textSize="11sp" android:text="ROOTFS"/>

            <TextView android:id="@+id/stRootfs" style="@style/YnValue"
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:textSize="10sp" android:textColor="@color/yn_ink_muted" android:text="—"/>
        </LinearLayout>

        <View android:layout_width="match_parent" android:layout_height="1dp"
            android:background="@color/yn_border_subtle"/>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingTop="6dp"
            android:paddingBottom="6dp">

            <TextView style="@style/YnValue" android:layout_width="52dp"
                android:layout_height="wrap_content" android:textSize="10sp"
                android:textColor="@color/yn_ink_muted" android:text="NET/01"/>

            <TextView style="@style/YnValue" android:layout_width="0dp"
                android:layout_weight="1" android:layout_height="wrap_content"
                android:textSize="11sp" android:text="NAPCAT"/>

            <TextView android:id="@+id/stProto" style="@style/YnValue"
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:textSize="10sp" android:textColor="@color/yn_ink_muted" android:text="—"/>
        </LinearLayout>

        <View android:layout_width="match_parent" android:layout_height="1dp"
            android:background="@color/yn_border_subtle"/>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingTop="6dp"
            android:paddingBottom="6dp">

            <TextView style="@style/YnValue" android:layout_width="52dp"
                android:layout_height="wrap_content" android:textSize="10sp"
                android:textColor="@color/yn_ink_muted" android:text="AUTH/02"/>

            <TextView style="@style/YnValue" android:layout_width="0dp"
                android:layout_weight="1" android:layout_height="wrap_content"
                android:textSize="11sp" android:text="QQ SESSION"/>

            <TextView android:id="@+id/stAuth" style="@style/YnValue"
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:textSize="10sp" android:textColor="@color/yn_ink_muted" android:text="—"/>
        </LinearLayout>

        <View android:layout_width="match_parent" android:layout_height="1dp"
            android:background="@color/yn_border_subtle"/>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingTop="6dp"
            android:paddingBottom="6dp">

            <TextView style="@style/YnValue" android:layout_width="52dp"
                android:layout_height="wrap_content" android:textSize="10sp"
                android:textColor="@color/yn_ink_muted" android:text="SES/03"/>

            <TextView style="@style/YnValue" android:layout_width="0dp"
                android:layout_weight="1" android:layout_height="wrap_content"
                android:textSize="11sp" android:text="CONSOLE :6099"/>

            <TextView android:id="@+id/stConsole" style="@style/YnValue"
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:textSize="10sp" android:textColor="@color/yn_ink_muted" android:text="—"/>
        </LinearLayout>

        <View android:layout_width="match_parent" android:layout_height="1dp"
            android:background="@color/yn_border"/>
    </LinearLayout>

    <!-- ── action row ────────────────────────────── -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingStart="18dp"
        android:paddingEnd="18dp"
        android:paddingTop="10dp">

        <Button
            android:id="@+id/start"
            style="@style/YnButton"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="44dp"
            android:textSize="12sp"
            android:minHeight="0dp"
            android:text="INITIALIZE"/>

        <Button
            android:id="@+id/open"
            style="@style/YnButtonGhost"
            android:layout_width="wrap_content"
            android:layout_height="44dp"
            android:layout_marginStart="9dp"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:textSize="11sp"
            android:minHeight="0dp"
            android:text="CONFIG"/>
    </LinearLayout>

    <!-- ── live terminal (takes remaining height) ── -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical"
        android:layout_marginTop="10dp">

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/yn_border"/>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingStart="18dp"
            android:paddingEnd="14dp"
            android:paddingTop="6dp"
            android:paddingBottom="4dp">

            <TextView
                style="@style/YnMeta"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:textColor="@color/yn_accent_ink"
                android:text="TERMINAL / LIVE"/>

            <TextView
                android:id="@+id/exportLog"
                style="@style/YnMeta"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingStart="8dp"
                android:paddingEnd="8dp"
                android:paddingTop="4dp"
                android:paddingBottom="4dp"
                android:textColor="@color/yn_accent"
                android:clickable="true"
                android:focusable="true"
                android:background="?android:attr/selectableItemBackground"
                android:text="LOG"/>

            <TextView
                android:id="@+id/copyLog"
                style="@style/YnMeta"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingStart="12dp"
                android:paddingEnd="4dp"
                android:paddingTop="4dp"
                android:paddingBottom="4dp"
                android:textColor="@color/yn_accent"
                android:text="COPY"/>
        </LinearLayout>

        <ScrollView
            android:id="@+id/logScroll"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:background="@color/yn_bg_panel"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:paddingTop="6dp"
            android:paddingBottom="6dp"
            android:scrollbars="vertical">

            <TextView
                android:id="@+id/status"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="monospace"
                android:textSize="10sp"
                android:lineSpacingExtra="2dp"
                android:textColor="@color/yn_ink"
                android:textIsSelectable="true"
                android:text="> awaiting initialization"/>
        </ScrollView>

        <!-- 二维码：出现时显示 -->
        <LinearLayout
            android:id="@+id/qrBox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center_horizontal"
            android:paddingTop="6dp"
            android:paddingBottom="6dp"
            android:visibility="gone">

            <ImageView
                android:id="@+id/qr"
                android:layout_width="132dp"
                android:layout_height="132dp"
                android:padding="4dp"
                android:scaleType="fitCenter"/>

            <TextView
                style="@style/YnMeta"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:textColor="@color/yn_accent_ink"
                android:text="SCAN WITH QQ"/>
        </LinearLayout>
    </LinearLayout>

</LinearLayout>
