<?xml version="1.0" encoding="utf-8"?>
<!-- 配置页：复用同一套 FUI 语法，可滚动，因为字段多 -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/yn_bg_base"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="18dp"
        android:paddingEnd="18dp"
        android:paddingTop="14dp"
        android:paddingBottom="20dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                style="@style/YnTitle"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:textSize="24sp"
                android:letterSpacing="0.03"
                android:text="CONFIG"/>

            <TextView
                android:id="@+id/close"
                style="@style/YnMeta"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:padding="8dp"
                android:textColor="@color/yn_accent"
                android:text="DONE"/>
        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="8dp"
            android:background="@color/yn_border"/>

        <!-- ENDPOINT -->
        <TextView style="@style/YnMeta" android:layout_width="wrap_content"
            android:layout_height="wrap_content" android:layout_marginTop="16dp"
            android:text="API ENDPOINT"/>
        <EditText
            android:id="@+id/endpoint"
            android:layout_width="match_parent"
            android:layout_height="46dp"
            android:layout_marginTop="5dp"
            android:background="@drawable/yn_input"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:fontFamily="monospace"
            android:textSize="12sp"
            android:textColor="@color/yn_ink"
            android:textColorHint="@color/yn_ink_faint"
            android:inputType="textUri"
            android:hint="https://api.openai.com/v1"/>

        <!-- API KEY -->
        <TextView style="@style/YnMeta" android:layout_width="wrap_content"
            android:layout_height="wrap_content" android:layout_marginTop="14dp"
            android:text="API KEY"/>
        <EditText
            android:id="@+id/apiKey"
            android:layout_width="match_parent"
            android:layout_height="46dp"
            android:layout_marginTop="5dp"
            android:background="@drawable/yn_input"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:fontFamily="monospace"
            android:textSize="12sp"
            android:textColor="@color/yn_ink"
            android:textColorHint="@color/yn_ink_faint"
            android:inputType="textPassword"
            android:hint="sk-..."/>

        <!-- MODEL -->
        <TextView style="@style/YnMeta" android:layout_width="wrap_content"
            android:layout_height="wrap_content" android:layout_marginTop="14dp"
            android:text="MODEL"/>
        <EditText
            android:id="@+id/model"
            android:layout_width="match_parent"
            android:layout_height="46dp"
            android:layout_marginTop="5dp"
            android:background="@drawable/yn_input"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:fontFamily="monospace"
            android:textSize="12sp"
            android:textColor="@color/yn_ink"
            android:textColorHint="@color/yn_ink_faint"
            android:inputType="text"
            android:hint="gpt-4o-mini"/>

        <!-- PERSONA -->
        <TextView style="@style/YnMeta" android:layout_width="wrap_content"
            android:layout_height="wrap_content" android:layout_marginTop="14dp"
            android:text="PERSONA / 对话规则"/>
        <EditText
            android:id="@+id/persona"
            android:layout_width="match_parent"
            android:layout_height="120dp"
            android:layout_marginTop="5dp"
            android:background="@drawable/yn_input"
            android:padding="12dp"
            android:gravity="top|start"
            android:fontFamily="sans-serif"
            android:textSize="12sp"
            android:lineSpacingExtra="3dp"
            android:textColor="@color/yn_ink"
            android:textColorHint="@color/yn_ink_faint"
            android:inputType="textMultiLine"
            android:hint="你是…"/>

        <!-- 回复范围 -->
        <TextView style="@style/YnMeta" android:layout_width="wrap_content"
            android:layout_height="wrap_content" android:layout_marginTop="16dp"
            android:text="REPLY SCOPE"/>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="8dp">

            <CheckBox
                android:id="@+id/groupMentionOnly"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:buttonTint="@color/yn_accent"
                android:textColor="@color/yn_ink"
                android:textSize="12sp"
                android:text="群里只回 @"/>

            <CheckBox
                android:id="@+id/replyPrivate"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:buttonTint="@color/yn_accent"
                android:textColor="@color/yn_ink"
                android:textSize="12sp"
                android:text="私聊全回"/>
        </LinearLayout>

        <!-- 上限 -->
        <TextView style="@style/YnMeta" android:layout_width="wrap_content"
            android:layout_height="wrap_content" android:layout_marginTop="14dp"
            android:text="CONTEXT MESSAGES"/>
        <EditText
            android:id="@+id/maxHistory"
            android:layout_width="match_parent"
            android:layout_height="46dp"
            android:layout_marginTop="5dp"
            android:background="@drawable/yn_input"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:fontFamily="monospace"
            android:textSize="12sp"
            android:textColor="@color/yn_ink"
            android:inputType="number"
            android:hint="8"/>


        <!-- 保活 -->
        <TextView style="@style/YnMeta" android:layout_width="wrap_content"
            android:layout_height="wrap_content" android:layout_marginTop="20dp"
            android:text="KEEP ALIVE"/>

        <TextView
            android:id="@+id/keepHint"
            style="@style/YnValue"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:textSize="11sp"
            android:textColor="@color/yn_ink_muted"
            android:text="电池优化: 检测中"/>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="8dp">

            <Button
                android:id="@+id/battery"
                style="@style/YnButtonGhost"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="44dp"
                android:minHeight="0dp"
                android:textSize="11sp"
                android:text="免电池优化"/>

            <Button
                android:id="@+id/autostart"
                style="@style/YnButtonGhost"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="44dp"
                android:layout_marginStart="8dp"
                android:minHeight="0dp"
                android:textSize="11sp"
                android:text="自启动设置"/>
        </LinearLayout>

        <Button
            android:id="@+id/save"
            style="@style/YnButton"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="22dp"
            android:minHeight="0dp"
            android:text="SAVE CONFIG"/>

        <TextView
            android:id="@+id/hint"
            style="@style/YnMeta"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:gravity="center"
            android:textColor="@color/yn_ink_muted"
            android:text="配置存在设备内，不会上传"/>

    </LinearLayout>
</ScrollView>
